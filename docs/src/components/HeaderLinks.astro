---
// Overrides Starlight's `SocialIcons` header slot so we can add a link to the previous
// (v0) documentation site next to the default social icons. Rendering `<Default />` keeps
// the built-in GitHub / social links intact.
import Default from '@astrojs/starlight/components/SocialIcons.astro';
---

<a
	class="site-header-link"
	href="https://v0.vite-dotnet.techgems.net"
	target="_blank"
	rel="noopener noreferrer"
>
	v0 Docs
</a>

<Default><slot /></Default>

<style>
	.site-header-link {
		display: inline-flex;
		align-items: center;
		padding: 0.3rem 0.7rem;
		margin-inline-end: 0.5rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		line-height: 1;
		white-space: nowrap;
		color: var(--sl-color-white);
		text-decoration: none;
		transition:
			background-color 0.15s ease,
			border-color 0.15s ease;
	}

	.site-header-link:hover {
		background-color: var(--sl-color-gray-6);
		border-color: var(--sl-color-text-accent);
	}
</style>
