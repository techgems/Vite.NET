# Package versions rendered throughout the documentation and the Claude Skill.
# Bump these on release — every version shown in the docs is read from here.
#
# `PUBLIC_` is what makes Astro expose them to pages at build time; the skill zip builder
# reads this same file, so the site and the downloadable skill can never disagree.
PUBLIC_NUGET_VERSION=1.0.0-beta
PUBLIC_NPM_VERSION=1.0.0-rc
