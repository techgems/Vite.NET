{
  // The backend only needs the directory name(s) of the integrated Vite app(s). Everything else
  // (entrypoint, container element id, port, whether the app is React) is read from the manifests
  // emitted by the Vite plugin. This may be a single string ("ViteDotNet": "ReactApp") or an array.
  "ViteDotNet": [ "ReactApp", "LatestViteReact" ],
  "DetailedErrors": true,
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
